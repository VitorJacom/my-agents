{
  "safety-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/safety-guard.sh"
          }
        ]
      }
    ]
  },
  "context-loader": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "./scripts/session-start-context.sh"
      }
    ]
  }
}
